# ──────────────────────────────────────────────────────────────────────
# CryptoVentures DAO — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────────────

# Deployer private key (hex, with or without 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Infura project ID for RPC access
INFURA_API_KEY=YOUR_INFURA_PROJECT_ID

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# CoinMarketCap API key for USD gas cost reporting
COINMARKETCAP_API_KEY=YOUR_COINMARKETCAP_API_KEY

# Set to "true" to enable gas reporting in tests
REPORT_GAS=false

# Guardian address (defaults to deployer if not set)
GUARDIAN_ADDRESS=0xYOUR_GUARDIAN_ADDRESS

# Admin address (multisig recommended for production)
ADMIN_ADDRESS=0xYOUR_ADMIN_MULTISIG_ADDRESS
